APP_ENV=development
APP_BIND=0.0.0.0:3000
BASE_URL=http://localhost:8080
# Local Caddy listener. Production: set SITE_ADDRESS=<your-domain> and publish 80/443.
SITE_ADDRESS=http://localhost
CADDY_HTTP_HOST=127.0.0.1
CADDY_HTTP_PORT=8080
CADDY_HTTPS_HOST=127.0.0.1
CADDY_HTTPS_PORT=8443
DATABASE_URL=sqlite:///data/go.db
RUST_LOG=info
# Long random secret (>= 32 bytes). Generate with: openssl rand -base64 48
CSRF_SIGNING_KEY=replace-me-with-a-long-random-secret-at-least-32-bytes
# Proof that management requests passed Caddy's Basic Auth. The app rejects
# direct /admin and /api requests without it. Generate with:
#   openssl rand -base64 48
# (>= 32 characters required in production; never commit the real value).
UPSTREAM_AUTH_TOKEN=replace-me-with-a-long-random-upstream-token
# Direct-to-app management access WITHOUT the proxy token. Development-only:
# honored only when APP_ENV=development AND the app is bound to a loopback
# address (e.g. direct `cargo run`). Production ignores it entirely.
# Set to exactly `true` to enable.
UPSTREAM_AUTH_ALLOW_DIRECT=false
# Argon2id hash for Caddy basic auth (never commit the real hash).
# Generate with: docker run --rm caddy:2 caddy hash-password --algorithm argon2id --plaintext '...'
# IMPORTANT: argon2id hashes contain `$`; in the real `.env` file every `$`
# must be escaped as `$$` or Compose will interpolate (and destroy) the hash.
ADMIN_PASSWORD_HASH=replace-me-with-argon2id-hash
