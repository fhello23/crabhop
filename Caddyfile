{
	servers {
		trusted_proxies static 172.16.0.0/12 127.0.0.1
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS} {
	log {
		output file /var/log/caddy/access.log {
			mode 0640
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	@management path /admin /admin/* /api /api/*

	basic_auth @management argon2id {
		admin {$ADMIN_PASSWORD_HASH}
	}

	reverse_proxy shortener:3000 {
		header_up -Authorization
		# Set (not append): this replaces any client-supplied value, so the
		# app trusts X-Crabhop-Proxy-Token only because Caddy overwrites it
		# here after Basic Auth succeeded.
		header_up X-Crabhop-Proxy-Token {$UPSTREAM_AUTH_TOKEN}
		header_up X-Authenticated-User {http.auth.user.id}
	}

	# Conservative HSTS: one year, no includeSubDomains (add it only once
	# every subdomain is known HTTPS), never preload without a review.
	header Strict-Transport-Security "max-age=31536000"
}
